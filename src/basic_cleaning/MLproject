name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: The name of the raw data file artifact in W&B
        type: string

      output_artifact:
        description: Name of the output file
        type: string

      output_type:
        description: Type of the artifact
        type: string

      output_description:
        description: Output artifact description
        type: string

      min_price:
        description: Minimum price value to keep in the data
        type: float

      max_price:
        description: Maximum price value to keep in the data
        type: float


    command: >-
        python data_cleaning.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
